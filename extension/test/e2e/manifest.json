      "oracle": {
        "kind": "authored-language-rule-and-dirty-currentness-contract",
        "explanation": "The unsaved provider is physically outside the workspace root but explicitly linked before the unchanged consumer. An equivalent parenthesized body and comment line move the same binding; only its current declaration range is valid. Baseline actual F12 must establish the former target before the unsaved edit; consumer text/version and all disk files must stay unchanged. This is independently authored source binding/currentness using an unqualified module use after explicit open Provider; no external receiver-term certificate is assumed, without generated evaluated metadata or compiler execution.",
        "source": "https://learn.microsoft.com/en-us/dotnet/fsharp/language-reference/modules"
      }
    },
