    {
      "id": "nested-shadow",
      "ruleId": "lexical.nested-shadow",
      "fixture": "small-unprepared",
      "query": {
        "file": "Local.fs",
        "line": 1,
        "character": 41,
        "token": "value"
      },
      "expected": {
        "kind": "exact",
        "target": {
          "file": "Local.fs",
          "range": {
            "start": {
              "line": 1,
              "character": 32
            },
            "end": {
              "line": 1,
              "character": 37
            }
          },
          "text": "value"
        },
        "forbidden": [
          {
            "file": "Local.fs",
            "range": {
              "start": {
                "line": 1,
                "character": 18
              },
              "end": {
                "line": 1,
                "character": 23
              }
            },
            "text": "value"
          }
        ]
      },
      "oracle": {
        "kind": "authored-language-rule",
        "explanation": "The use is inside the inner lambda and binds its parameter, not the outer same-named parameter.",
        "source": "https://learn.microsoft.com/en-us/dotnet/fsharp/language-reference/functions/let-bindings"
      }
    },
